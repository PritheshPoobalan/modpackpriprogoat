# Packaged modpack archives
*.zip
*.jar

# Working copy of the manifest (generated from the example)
/modpack.json

# Downloaded mod files
mods/

# Operating system files
.DS_Store
Thumbs.db
Thumbs.db:ignorable
desktop.ini

# Editor and IDE artifacts
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Logs and temporary files
*.log
*.tmp
*.temp

# Secrets — never commit credentials or API keys
.env
.env.local
secrets/

# Build and output artifacts
dist/
build/
out/
